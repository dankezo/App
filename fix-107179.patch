+/**
+ * Whether a build config value names a real environment. Config values come from the .env file baked into the bundle,
+ * so an unexpected value falls back to production instead of indexing the URL map with it.
+ */
+function isEnvironment(environment: string): environment is Environment {
+    return Object.values(CONST.ENVIRONMENT).some((knownEnvironment) => knownEnvironment === environment);
+}
+
+/**
+ * The environment that can be known synchronously from the build config, without waiting on the native beta bridge.
+ * It is read straight from the URL map, so the seed origin equals the live environment URL on every build whose
+ * environment is baked in: development, adhoc, staging and QA configs all resolve from the map, matching what the
+ * async lookup returns for them. The one case the config cannot decide is a native store build, where staging and
+ * production ship the same binary and only the beta check tells them apart: those builds bake ENVIRONMENT=production,
+ * so they report production here, in parity with EnvironmentContextProvider's default, and the async lookup corrects
+ * a TestFlight build to staging once it resolves.
+ */
+function getCurrentEnvironment(): Environment {
+    const environment = Config?.ENVIRONMENT ?? CONST.ENVIRONMENT.DEV;
+    if (isEnvironment(environment)) {
+        return environment;
+    }
+    return CONST.ENVIRONMENT.PRODUCTION;
+}
+
+/**
+ * Get the environment URL synchronously from the build config. Use this to seed module-level URLs so links built
+ * before the async lookup resolves already point at the right origin on every build.
+ */
+function getCurrentEnvironmentURL(): string {
+    return ENVIRONMENT_URLS[getCurrentEnvironment()];
+}
+
+/**
+ * Get the corresponding oldDot URL synchronously from the build config, with the same fallback as getCurrentEnvironmentURL.
+ */
+function getCurrentOldDotEnvironmentURL(): string {
+    return OLDDOT_ENVIRONMENT_URLS[getCurrentEnvironment()];
+}
+
 /**
  * Given the environment get the corresponding oldDot URL
  */
@@ -67,4 +107,4 @@ function getOldDotEnvironmentURL(): Promise<string> {
     return getEnvironment().then((environment) => OLDDOT_ENVIRONMENT_URLS[environment]);
 }
 
