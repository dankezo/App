diff --git a/tests/unit/EnvironmentURLRaceTest.ts b/tests/unit/EnvironmentURLRaceTest.ts
new file mode 100644
index 00000000..eb652a1c
--- /dev/null
+++ b/tests/unit/EnvironmentURLRaceTest.ts
@@ -0,0 +1,275 @@
+import CONFIG from '@src/CONFIG';
+import CONST from '@src/CONST';
+import type {ReportAction} from '@src/types/onyx';
+
+import type {LocalizedTranslate} from '@components/LocaleContextProvider';
+import type * as EnvironmentModule from '@libs/Environment/Environment';
+
+// On native, getEnvironment() waits on the betaChecker bridge before it resolves, so at
+// cold start the module-level environment URLs are still unset while report actions render.
+// These deferred promises hold the environment lookup pending to reproduce that race.
+let resolveEnvironmentURL: (url: string) => void;
+let environmentURLPromise: Promise<string>;
+let resolveOldDotEnvironmentURL: (url: string) => void;
+let oldDotEnvironmentURLPromise: Promise<string>;
+
+// The synchronous seed the four library files read at module load. Tests set these before
+// loading the modules, to stand in for the build config of a dev build or a store build.
+let syncEnvironmentURL = CONST.NEW_EXPENSIFY_URL;
+let syncOldDotEnvironmentURL = CONST.EXPENSIFY_URL;
+
+// The modules under test are re-required from a fresh registry, so their translate lookup
+// has no locale loaded; a stub that echoes the parameters keeps the assertions on the URL.
+const translateStub = ((key: string, ...params: Array<string | number | boolean>) => `${key}::${params.join('|')}`) as unknown as LocalizedTranslate;
+
+// The integration sync failed action every oldDot link test builds its message from. The message builders only read
+// it, so one shared action keeps the three tests on the same input.
+const integrationSyncFailedAction = {
+    actionName: CONST.REPORT.ACTIONS.TYPE.INTEGRATION_SYNC_FAILED,
+    originalMessage: {label: 'QuickBooks Online', errorMessage: 'Sync failed', recurrenceCount: 1},
+} as unknown as ReportAction;
+
+type ModulesUnderTest = {
+    getReportURLForCurrentContext: (reportID: string | undefined) => string;
+    getCreatedReportForUnapprovedTransactionsMessage: (reportID: string | undefined, reportName: string, isReportDeleted: boolean, translate: LocalizedTranslate) => string;
+    getIntegrationSyncFailedMessage: (translate: LocalizedTranslate, action: ReportAction, policyID?: string, shouldShowOldDotLink?: boolean) => string;
+};
+
+function loadModulesWithPendingEnvironment(): ModulesUnderTest {
+    environmentURLPromise = new Promise<string>((resolve) => {
+        resolveEnvironmentURL = resolve;
+    });
+    oldDotEnvironmentURLPromise = new Promise<string>((resolve) => {
+        resolveOldDotEnvironmentURL = resolve;
+    });
+
+    jest.doMock('@libs/Environment/Environment', () => ({
+        getEnvironmentURL: () => environmentURLPromise,
+        getOldDotEnvironmentURL: () => oldDotEnvironmentURLPromise,
+        getCurrentEnvironmentURL: () => syncEnvironmentURL,
+        getCurrentOldDotEnvironmentURL: () => syncOldDotEnvironmentURL,
+        getOldDotURLFromEnvironment: () => CONST.EXPENSIFY_URL,
+        isDevelopment: () => false,
+        isProduction: () => Promise.resolve(false),
+        isInternalTestBuild: () => false,
+    }));
+
+    jest.resetModules();
+
+    // eslint-disable-next-line @typescript-eslint/no-require-imports
+    const getReportURLForCurrentContext = require('@libs/Navigation/helpers/getReportURLForCurrentContext').default as ModulesUnderTest['getReportURLForCurrentContext'];
+    // eslint-disable-next-line @typescript-eslint/no-require-imports
+    const ReportActionsUtils = require('@libs/ReportActionsUtils') as ModulesUnderTest;
+
+    return {
+        getReportURLForCurrentContext,
+        getCreatedReportForUnapprovedTransactionsMessage: ReportActionsUtils.getCreatedReportForUnapprovedTransactionsMessage,
+        getIntegrationSyncFailedMessage: ReportActionsUtils.getIntegrationSyncFailedMessage,
+    };
+}
+
+describe('environment URL cold-start race (issue #107179)', () => {
+    afterEach(() => {
+        jest.resetModules();
+        jest.dontMock('@libs/Environment/Environment');
+        syncEnvironmentURL = CONST.NEW_EXPENSIFY_URL;
+        syncOldDotEnvironmentURL = CONST.EXPENSIFY_URL;
+    });
+
+    it('should build a valid report URL while the environment lookup is still pending', () => {
+        // Given the environment lookup has not resolved yet (cold start on native)
+        const {getReportURLForCurrentContext} = loadModulesWithPendingEnvironment();
+
+        // When the report URL is built for the held expense report
+        const reportURL = getReportURLForCurrentContext('67890');
+
+        // Then the URL is rooted at the production default instead of "undefined/r/..."
+        expect(reportURL).toBe(`${CONST.NEW_EXPENSIFY_URL}/r/67890`);
+        expect(reportURL).not.toContain('undefined');
+    });
+
+    it('should render the held-expense system message without an "undefined" report link while the environment lookup is still pending', () => {
+        // Given the environment lookup has not resolved yet (cold start on native)
+        const {getCreatedReportForUnapprovedTransactionsMessage} = loadModulesWithPendingEnvironment();
+
+        // When the system message for the held expenses is built
+        const message = getCreatedReportForUnapprovedTransactionsMessage('67890', 'Original Report', false, translateStub);
+
+        // Then the message links to a valid report URL instead of "undefined/r/..."
+        expect(message).toContain(`${CONST.NEW_EXPENSIFY_URL}/r/67890`);
+        expect(message).not.toContain('undefined/r/');
+    });
+
+    it('should build a valid oldDot link while the environment lookup is still pending', () => {
+        // Given the environment lookup has not resolved yet (cold start on native)
+        const {getIntegrationSyncFailedMessage} = loadModulesWithPendingEnvironment();
+
+        // When the integration sync failed message is built with an oldDot link
+        const message = getIntegrationSyncFailedMessage(translateStub, integrationSyncFailedAction, 'ABC123', true);
+
+        // Then the link is rooted at the production oldDot URL instead of "undefined/policy..."
+        expect(message).toContain(`${CONST.EXPENSIFY_URL}/policy?param=`);
+        expect(message).not.toContain('undefined/policy');
+    });
+
+    it('should use the resolved environment URL once the lookup settles', async () => {
+        // Given the environment lookup is pending at first on a store build, seeded with production. This is the
+        // TestFlight case: staging and production ship the same binary, so only the beta check can tell them apart,
+        // and the async lookup is what corrects the seed to staging once it resolves.
+        const {getReportURLForCurrentContext, getIntegrationSyncFailedMessage} = loadModulesWithPendingEnvironment();
+        expect(getReportURLForCurrentContext('67890')).toBe(`${CONST.NEW_EXPENSIFY_URL}/r/67890`);
+        expect(getIntegrationSyncFailedMessage(translateStub, integrationSyncFailedAction, 'ABC123', true)).toContain(
+            `${CONST.EXPENSIFY_URL}/policy?param=`,
+        );
+
+        // When the lookup resolves to the staging URL
+        resolveEnvironmentURL(CONST.STAGING_NEW_EXPENSIFY_URL);
+        resolveOldDotEnvironmentURL(CONST.STAGING_EXPENSIFY_URL);
+        await environmentURLPromise;
+        await oldDotEnvironmentURLPromise;
+
+        // Then later URLs use the resolved environment URL, for both the newDot and the oldDot links
+        expect(getReportURLForCurrentContext('67890')).toBe(`${CONST.STAGING_NEW_EXPENSIFY_URL}/r/67890`);
+        expect(getIntegrationSyncFailedMessage(translateStub, integrationSyncFailedAction, 'ABC123', true)).toContain(
+            `${CONST.STAGING_EXPENSIFY_URL}/policy?param=`,
+        );
+    });
+
+    it('should seed a dev build link whose origin equals the live dev origin while the lookup is still pending', () => {
+        // Given a development build, whose synchronous seed comes from the environment URL map, and the async
+        // lookup is still pending. openLink only navigates in-app when the href origin equals the live
+        // environment URL, so a production-seeded link on a dev build would open the browser to production.
+        syncEnvironmentURL = `${CONST.DEV_NEW_EXPENSIFY_URL}${CONFIG.DEV_PORT}`;
+        const {getReportURLForCurrentContext} = loadModulesWithPendingEnvironment();
+
+        // When the report URL is built for the held expense report
+        const reportURL = getReportURLForCurrentContext('67890');
+
+        // Then the built link origin equals the live dev origin, not the production origin
+        expect(new URL(reportURL).origin).toBe(new URL(`${CONST.DEV_NEW_EXPENSIFY_URL}${CONFIG.DEV_PORT}`).origin);
+        expect(new URL(reportURL).origin).not.toBe(new URL(CONST.NEW_EXPENSIFY_URL).origin);
+    });
+
+    it('should seed the report URL with the development URL on a dev build while the environment lookup is still pending', () => {
+        // Given a development build, whose synchronous seed is the dev URL, and the async lookup is still pending
+        syncEnvironmentURL = `${CONST.DEV_NEW_EXPENSIFY_URL}${CONFIG.DEV_PORT}`;
+        const {getReportURLForCurrentContext} = loadModulesWithPendingEnvironment();
+
+        // When the report URL is built for the held expense report
+        const reportURL = getReportURLForCurrentContext('67890');
+
+        // Then the URL is rooted at the dev origin, not at production, so a dev build never links to production
+        expect(reportURL).toBe(`${CONST.DEV_NEW_EXPENSIFY_URL}${CONFIG.DEV_PORT}/r/67890`);
+        expect(reportURL).not.toContain('undefined');
+    });
+
+    it('should seed the oldDot link with the development oldDot URL on a dev build while the environment lookup is still pending', () => {
+        // Given a development build, whose synchronous oldDot seed is the dev oldDot URL, and the async lookup is still pending
+        syncOldDotEnvironmentURL = CONST.INTERNAL_DEV_EXPENSIFY_URL;
+        const {getIntegrationSyncFailedMessage} = loadModulesWithPendingEnvironment();
+
+        // When the integration sync failed message is built with an oldDot link
+        const message = getIntegrationSyncFailedMessage(translateStub, integrationSyncFailedAction, 'ABC123', true);
+
+        // Then the link is rooted at the dev oldDot origin instead of the production oldDot origin
+        expect(message).toContain(`${CONST.INTERNAL_DEV_EXPENSIFY_URL}/policy?param=`);
+        expect(message).not.toContain('undefined/policy');
+    });
+
+    it('should fall back to the production URL on a store build while the environment lookup is still pending', () => {
+        // Given a store build, whose baked config is production: staging and production ship the same binary, so
+        // the beta check is the only signal that can tell them apart, and the async lookup is still pending
+        syncEnvironmentURL = CONST.NEW_EXPENSIFY_URL;
+        syncOldDotEnvironmentURL = CONST.EXPENSIFY_URL;
+        const {getReportURLForCurrentContext, getIntegrationSyncFailedMessage} = loadModulesWithPendingEnvironment();
+
+        // When report URLs are built before the lookup settles
+        const reportURL = getReportURLForCurrentContext('67890');
+        const message = getIntegrationSyncFailedMessage(translateStub, integrationSyncFailedAction, 'ABC123', true);
+
+        // Then both links use the production origins, matching EnvironmentContextProvider's default
+        expect(reportURL).toBe(`${CONST.NEW_EXPENSIFY_URL}/r/67890`);
+        expect(message).toContain(`${CONST.EXPENSIFY_URL}/policy?param=`);
+    });
+});
+
+describe('synchronous environment URL getters', () => {
+    // The build config value the real Environment module reads. Each test sets it before
+    // requiring the module from a fresh registry, so the getter under test sees that build.
+    let mockConfigEnvironment = CONST.ENVIRONMENT.DEV;
+
+    function loadRealEnvironmentModule(): typeof EnvironmentModule {
+        jest.doMock('react-native-config', () => ({
+            __esModule: true,
+            default: {ENVIRONMENT: mockConfigEnvironment},
+        }));
+        jest.resetModules();
+
+        // eslint-disable-next-line @typescript-eslint/no-require-imports
+        return require<typeof EnvironmentModule>('@libs/Environment/Environment');
+    }
+
+    afterEach(() => {
+        jest.resetModules();
+        jest.dontMock('react-native-config');
+        jest.dontMock('@libs/Environment/Environment');
+        mockConfigEnvironment = CONST.ENVIRONMENT.DEV;
+    });
+
+    it('should return the development URLs for a development build', () => {
+        // Given a development build config
+        mockConfigEnvironment = CONST.ENVIRONMENT.DEV;
+        const {getCurrentEnvironmentURL, getCurrentOldDotEnvironmentURL} = loadRealEnvironmentModule();
+
+        // When the synchronous getters are called
+        // Then they return the dev origins, including the dev port
+        expect(getCurrentEnvironmentURL()).toBe(`${CONST.DEV_NEW_EXPENSIFY_URL}${CONFIG.DEV_PORT}`);
+        expect(getCurrentOldDotEnvironmentURL()).toBe(CONST.INTERNAL_DEV_EXPENSIFY_URL);
+    });
+
+    it('should return the staging URLs for an adhoc build', () => {
+        // Given an adhoc build config, which always resolves to staging
+        mockConfigEnvironment = CONST.ENVIRONMENT.ADHOC;
+        const {getCurrentEnvironmentURL, getCurrentOldDotEnvironmentURL} = loadRealEnvironmentModule();
+
+        // When the synchronous getters are called
+        // Then they return the staging origins
+        expect(getCurrentEnvironmentURL()).toBe(CONST.STAGING_NEW_EXPENSIFY_URL);
+        expect(getCurrentOldDotEnvironmentURL()).toBe(CONST.STAGING_EXPENSIFY_URL);
+    });
+
+    it('should return the production URLs for a production build', () => {
+        // Given a production build config
+        mockConfigEnvironment = CONST.ENVIRONMENT.PRODUCTION;
+        const {getCurrentEnvironmentURL, getCurrentOldDotEnvironmentURL} = loadRealEnvironmentModule();
+
+        // When the synchronous getters are called
+        // Then they return the production origins
+        expect(getCurrentEnvironmentURL()).toBe(CONST.NEW_EXPENSIFY_URL);
+        expect(getCurrentOldDotEnvironmentURL()).toBe(CONST.EXPENSIFY_URL);
+    });
+
+    it('should return the staging URLs for a staging build', () => {
+        // Given a staging build config: on web the async lookup returns staging straight from the config, and no
+        // native flavor bakes ENVIRONMENT=staging, so the map value is the live URL either way
+        mockConfigEnvironment = CONST.ENVIRONMENT.STAGING;
+        const {getCurrentEnvironmentURL, getCurrentOldDotEnvironmentURL} = loadRealEnvironmentModule();
+
+        // When the synchronous getters are called
+        // Then they return the staging origins
+        expect(getCurrentEnvironmentURL()).toBe(CONST.STAGING_NEW_EXPENSIFY_URL);
+        expect(getCurrentOldDotEnvironmentURL()).toBe(CONST.STAGING_EXPENSIFY_URL);
+    });
+
+    it('should return the QA URLs for a QA build', () => {
+        // Given a QA build config: on web the async lookup returns QA straight from the config, and no native
+        // flavor bakes ENVIRONMENT=qa, so the map value is the live URL either way
+        mockConfigEnvironment = CONST.ENVIRONMENT.QA;
+        const {getCurrentEnvironmentURL, getCurrentOldDotEnvironmentURL} = loadRealEnvironmentModule();
+
+        // When the synchronous getters are called
+        // Then they return the QA origins
+        expect(getCurrentEnvironmentURL()).toBe(CONST.QA_NEW_EXPENSIFY_URL);
+        expect(getCurrentOldDotEnvironmentURL()).toBe(CONST.QA_EXPENSIFY_URL);
+    });
+});
